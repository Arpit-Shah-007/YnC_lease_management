# Copy to .env.local and fill in your own values. Never commit .env.local.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Bypasses RLS, so never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Public origin, used to build Supabase auth redirect links
# (password reset, email confirmation). Use your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
